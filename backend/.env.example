# Copy to .env and adjust for your local Postgres instance.
# Requires the pg_trgm and vector (pgvector) extensions to be installable by
# this role — the initial Alembic migration runs CREATE EXTENSION IF NOT
# EXISTS for both.
DATABASE_URL=postgresql+psycopg://pillcheck:pillcheck@localhost:5432/pillcheck

# Must match the output dimension of whatever embedding model linking/ calls.
EMBEDDING_DIM=1536

# Below this cosine-similarity/confidence threshold, linking/resolver.py
# abstains (reports the item as unrecognized-with-suggestions) rather than
# guessing. Tune once real matching is implemented and evaluated.
LINKING_ABSTAIN_THRESHOLD=0.55

# Groq (OpenAI-compatible chat completions API) — powers app.explain.llm's
# prose rendering. Get a key at https://console.groq.com. Falls back to a
# deterministic template if unset, so this is optional for local dev.
# NEVER commit a real key here — this file is checked into git, put real
# values only in your local, gitignored .env.
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# Firebase — login gate only. This is the project id from the frontend's
# public web app config, not a secret (verification uses Google's public
# certs, no service account key needed).
FIREBASE_PROJECT_ID=your-firebase-project-id
